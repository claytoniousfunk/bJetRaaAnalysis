# Build the standalone PbPb pf-candidate analyzer.
#
#   make -f Makefile.pfCandAnalyzer
#   ./pfCandAnalyzer_PbPb 1
#
# Requires root-config and fastjet-config in PATH (source the LCG view first).
# See main_pfCandAnalyzer.cc for why this exists instead of an ACLiC build.

TARGET := pfCandAnalyzer_PbPb

ROOTCFLAGS := $(shell root-config --cflags)
ROOTLIBS   := $(shell root-config --libs)
FJCFLAGS   := $(shell fastjet-config --cxxflags)
FJLIBS     := $(shell fastjet-config --libs)
FJPREFIX   := $(shell fastjet-config --prefix)
# fjcontrib (ConstituentSubtractor, for the forest akCs4PF emulation in
# headers/functions/csJetEmulation.h). The forest used fjcontrib 1.033, and
# csJetEmulation.h is written against its API: LCG_106's bundled fjcontrib is newer
# and does not compile (set_do_mass_subtraction takes no argument there).
# Default: $HOME/fjcontrib1033 when it exists -- on lxplus that is fjcontrib 1.033
# (ConstituentSubtractor only) built against the LCG_106 FastJet 3.4.1, the build of
# the 2026-10-29 MinBias forest-CS scans -- else the FastJet prefix. Override with
# FJCONTRIB=<prefix>. Validate another version with src/plots/csJets/validateCSJets.C.
FJCONTRIB_DEFAULT := $(if $(wildcard $(HOME)/fjcontrib1033/lib/libfastjetcontribfragile.so),$(HOME)/fjcontrib1033,$(FJPREFIX))
FJCONTRIB  ?= $(FJCONTRIB_DEFAULT)

ifeq ($(strip $(FJCFLAGS)),)
  $(error fastjet-config not found in PATH -- source the LCG view first)
endif
ifeq ($(strip $(ROOTCFLAGS)),)
  $(error root-config not found in PATH -- source the LCG view first)
endif

# -Wno-* only silences the pre-existing warnings in the analysis headers so real
# problems stay visible.
CXXFLAGS := -O2 -DDO_FASTJET $(ROOTCFLAGS) $(FJCFLAGS) -I$(FJCONTRIB)/include \
            -Wno-sign-compare -Wno-empty-body -Wno-ignored-qualifiers

# rpath so the binary finds the standalone libfastjet without relying on
# LD_LIBRARY_PATH being identical on the worker node.
# fjcontrib first: it needs libfastjettools, so that has to follow it.
LDFLAGS := $(ROOTLIBS) -L$(FJCONTRIB)/lib -lfastjetcontribfragile -Wl,-rpath,$(FJCONTRIB)/lib \
           $(FJLIBS) -lfastjettools -Wl,-rpath,$(FJPREFIX)/lib

SRC     := main_pfCandAnalyzer.cc
DEPFILE := $(TARGET).d

.PHONY: all clean
all: $(TARGET)

# -MMD -MF records every header the compile actually pulled in, and the
# generated .d file is included below. Without it make only watches the two
# files named here, so an edit to a config header -- e.g. flipping
# doHiBinReweightToHardProbesJet80 in headers/config/config_PbPb.h -- leaves the
# binary silently stale and the next run uses the old setting.
$(TARGET): $(SRC)
	$(CXX) $(CXXFLAGS) -MMD -MF $(DEPFILE) -o $@ $(SRC) $(LDFLAGS)

-include $(DEPFILE)

clean:
	rm -f $(TARGET) $(DEPFILE)
