# Build the standalone PbPb CaloTower analyzer.
#
#   make -f Makefile.caloTowerAnalyzer
#   ./caloTowerAnalyzer_PbPb 1
#
# Requires root-config and fastjet-config in PATH (source the LCG view first).
# See main_caloTowerAnalyzer.cc for why this exists instead of an ACLiC build.
#
# Deliberately a separate TARGET and DEPFILE from Makefile.pfCandAnalyzer: the
# two analyzers share every analysis header, so a single target name would let
# one overwrite the other's binary and .d file and leave whichever was built
# first silently stale.

TARGET := caloTowerAnalyzer_PbPb

ROOTCFLAGS := $(shell root-config --cflags)
ROOTLIBS   := $(shell root-config --libs)
FJCFLAGS   := $(shell fastjet-config --cxxflags)
FJLIBS     := $(shell fastjet-config --libs)
FJPREFIX   := $(shell fastjet-config --prefix)

ifeq ($(strip $(FJCFLAGS)),)
  $(error fastjet-config not found in PATH -- source the LCG view first)
endif
ifeq ($(strip $(ROOTCFLAGS)),)
  $(error root-config not found in PATH -- source the LCG view first)
endif

# -Wno-* only silences the pre-existing warnings in the analysis headers so real
# problems stay visible.
CXXFLAGS := -O2 -DDO_FASTJET $(ROOTCFLAGS) $(FJCFLAGS) \
            -Wno-sign-compare -Wno-empty-body -Wno-ignored-qualifiers

# rpath so the binary finds the standalone libfastjet without relying on
# LD_LIBRARY_PATH being identical on the worker node.
LDFLAGS := $(ROOTLIBS) $(FJLIBS) -Wl,-rpath,$(FJPREFIX)/lib

SRC     := main_caloTowerAnalyzer.cc
DEPFILE := $(TARGET).d

.PHONY: all clean
all: $(TARGET)

# -MMD -MF records every header the compile actually pulled in, and the
# generated .d file is included below. Without it make only watches the two
# files named here, so an edit to a config header -- e.g. changing towerEtMin in
# headers/AnalysisSetup/caloTowers.h -- leaves the binary silently stale and the
# next run clusters at the old threshold while the filename claims the new one.
$(TARGET): $(SRC)
	$(CXX) $(CXXFLAGS) -MMD -MF $(DEPFILE) -o $@ $(SRC) $(LDFLAGS)

-include $(DEPFILE)

clean:
	rm -f $(TARGET) $(DEPFILE)
